{
  "lock": false,
  "nodeModulesDir": "auto",
  "unstable": ["kv", "cron"],
  "deploy": {
    "org": "pibulus",
    "app": "stargram"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check \"**/*.ts\" && deno check \"**/*.tsx\"",
    "cli": "echo \"import '\\$fresh/src/dev/cli.ts'\" | deno run --unstable -A -",
    "manifest": "deno task cli manifest $(pwd)",
    "start": "PORT=8002 deno run -A --unstable-kv --unstable-cron --watch=static/,routes/ dev.ts",
    "dev": "PORT=8002 deno run -A --unstable-kv --unstable-cron --watch=static/,routes/ dev.ts",
    "build": "deno run -A dev.ts build",
    "preview": "deno run -A --unstable-kv --unstable-cron main.ts",
    "update": "deno run -A -r https://fresh.deno.dev/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    "node_modules/"
  ],
  "imports": {
    "$fresh/": "https://deno.land/x/fresh@1.7.3/",
    "preact": "https://esm.sh/preact@10.22.0",
    "preact/": "https://esm.sh/preact@10.22.0/",
    "@preact/signals": "https://esm.sh/*@preact/signals@1.2.2",
    "@preact/signals-core": "https://esm.sh/*@preact/signals-core@1.5.1",
    "$std/": "https://deno.land/std@0.216.0/",
    "tailwindcss": "npm:tailwindcss@^3.4.0",
    "typed.js": "npm:typed.js@^2.1.0",
    "simplex-noise": "npm:simplex-noise@^4.0.1"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns",
      "deno.unstable"
    ]
  }
}
