# The Oracle's voice (REQUIRED for real readings)
# Google AI Studio key: https://aistudio.google.com/apikey
# Without it speakReading() returns null, composeFallback() runs, and the API
# still answers 200 OK with source: "oracle-fallback" — 64 sentence skeletons
# instead of a reading. Nothing else breaks, which is exactly why it is easy to
# miss. Check with: curl -s '<host>/api/horoscope?sign=leo' | grep -o '"source":"[^"]*"'
STARGRAM_GEMINI_KEY=your_google_ai_studio_key_here

# PostHog Analytics (optional)
# Sign up at https://posthog.com for free analytics
# If not set, analytics will be disabled
POSTHOG_KEY=your_posthog_project_key_here
POSTHOG_HOST=https://us.i.posthog.com
